if (Keyboard.SPACE && GetCreepCount() < 8) {
	import "spawn_creep.toy" as doTheCreep;
	var creep = doTheCreep();
}

if (Keyboard.ENTER && GetCreepCount() > 0) {
	var creep = GetCreepByIndex( rand() % GetCreepCount() );
	DestroyCreep(creep);
}

//DEBUG: move the creeps randomly
for (var i = 0; i < GetCreepCount(); i++) {
	var creep = GetCreepByIndex(i);
	creep.move(rand() % 10);
}
