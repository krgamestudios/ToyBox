if (KeyPressed.SPACE && GetCreepCount() < 8) {
	import "spawn_creep.toy" as doTheCreep;
	var creep = doTheCreep();
}

if (KeyPressed.ENTER && GetCreepCount() > 0) {
	var creep = GetCreepIndex( rand() % GetCreepCount() );
	DestroyCreep(creep);
}

//DEBUG: move the creeps randomly
for (var i = 0; i < GetCreepCount(); i++) {
	var creep = GetCreepIndex(i);
	creep.move(rand() % 10);
}
