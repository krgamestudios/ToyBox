//NOTE: this is a placeholder creep spawner

//get the environment
var terrain = GetTerrain();

//try and find an empty space
var x = 0;
var y = 0;

for (var i = 0; i < 100; i++) {
	x = rand() % terrain.width;
	y = rand() % terrain.height;

	if (terrain.getTile(x, y) == 0) { //empty and useable
		print x.asString .. " " .. y.asString;
		return CreateCreep(x, y);
	}
}

//if nothing found, this script must return one value
return null;
