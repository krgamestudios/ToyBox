if (KeyPressed.SPACE && GetCreepCount() < 8) {
	var terrain = GetTerrain();

	//try and find a good spawn point
	var x = 0;
	var y = 0;

	for (var i = 0; i < 100; i++) {
		x = abs(rand()) % terrain.width;
		y = abs(rand()) % terrain.height;

		if (terrain.getTile(x, y) == 0) { //empty and useable
			CreateCreep(x, y);
			break;
		}
	}
}

