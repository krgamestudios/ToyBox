//filter functions
fn findCellsByCriteria(terrain, validator) {
	var x: Array = [];
	var y: Array = [];

	for (var j = 0; j < terrain.height; j++) {
		for (var i = 0; i < terrain.width; i++) {
			if (validator(terrain, i, j)) {
				x.pushBack(i);
				y.pushBack(j);
			}
		}
	}

	return [x, y];
}

fn coreCriteria(terrain, x, y) {
	if (terrain.getTile(x, y) != 0) return false; //is a floor
	if (x <= 0 || y <= 0 || x >= terrain.width-1 || y >= terrain.height-1) return false; //is not an edge

	//margin of 1
	var total: Int = 0;
	for (var i = -1; i <= 1; i++) {
		for (var j = -1; j <= 1; j++) {
			if (x+i < 0 || y+j < 0 || x+i >= terrain.width || y+j >= terrain.height) continue;
			if (terrain.getTile(x+i, y+j) == 0) total++;
		}
	}

	return total == 9;
}

fn sourceCriteria(terrain, x, y) {
	if (terrain.getTile(x, y) != 1) return false; //is a wall
	if (x <= 0 || y <= 0 || x >= terrain.width-1 || y >= terrain.height-1) return false; //is not an edge

	var total: Int = 0;
	for (var i = -1; i <= 1; i++) {
		for (var j = -1; j <= 1; j++) {
			if (x+i < 0 || y+j < 0 || x+i >= terrain.width || y+j >= terrain.height) continue;
			if (terrain.getTile(x+i, y+j) == 1) total++;
		}
	}

	return total >= 1 && total <= 8;
}

//if no preexisting terrain is available, make some
var terrain = LoadTerrain();

if (terrain == null) {
	terrain = CreateTerrain(40, 40);

	//set up some "walls" along the edges
	for (var i = 0; i < terrain.width; i++) {
		terrain.setTile(i, 0, 1);
		terrain.setTile(i, terrain.height - 1, 1);
	}

	for (var j = 0; j < terrain.height; j++) {
		terrain.setTile(0, j, 1);
		terrain.setTile(terrain.width - 1, j, 1);
	}

	//add some random greebles
	for (var _ = 0; _ < 15; _++) {
		var x = rand() % 30 + 5;
		var y = rand() % 30 + 5;

		for (var i = 0; i < 3; i++) {
			for (var j = 0; j < 3; j++) {
				terrain.setTile(x + i, y + j, 1);
			}
		}
	}

	//possible core locations
	var coreCanditates = findCellsByCriteria(terrain, coreCriteria);
	var coreCanditatesX = coreCanditates[0];
	var coreCanditatesY = coreCanditates[1];
	coreCanditates = null;

	var coresX: Array = [];
	var coresY: Array = [];

	for (var _ = 0; _ < 8; _++) {
		//find a valid result that hasn't been removed
		var index = -1;
		while(index < 0) {
			index = rand() % coreCanditatesX.length;
			if (coreCanditatesX[index] < 0 || coreCanditatesY[index] < 0) {
				index = -1;
				continue;
				assert false, "first terrain assert failed";
			}

			//check this doesn't overlap existing cores (remove it if it does)
			for (var foobar = 0; foobar < coresX.length; foobar++) {
				if (abs(coreCanditatesX[index] - coresX[foobar]) <= 2 || abs(coreCanditatesY[index] - coresY[foobar]) <= 2) {
					coreCanditatesX[index] = -1;
					coreCanditatesY[index] = -1;
					index = -1;
					break; //breaks from the for, returning to the while
					assert false, "second terrain assert failed";
				}
			}
		}

		//finally, accept this candidtate and remove it
		coresX.pushBack(coreCanditatesX[index]);
		coresY.pushBack(coreCanditatesY[index]);
		coreCanditatesX[index] = -1;
		coreCanditatesY[index] = -1;

	}

	//store the cores as flags
	for (var i = 0; i < 8; i++) {
		terrain.setFlag(i, coresX[i], coresY[i]);
	}

	//possible source locations
	var sourceCandidates = findCellsByCriteria(terrain, sourceCriteria);
	var sourceCandidatesX = sourceCandidates[0];
	var sourceCandidatesY = sourceCandidates[1];
	sourceCandidates = null;

	for (var _ = 0; _ < 2; _++) {
		//find a valid result that hasn't been removed
		var index = -1;
		while(index < 0 || sourceCandidatesX[index] < 0) {
			index = rand() % sourceCandidatesX.length;
		}

		//set the flag and remove it
		terrain.setFlag(_ + 8, sourceCandidatesX[index], sourceCandidatesY[index]);

		sourceCandidatesX[index] = -1;
		sourceCandidatesY[index] = -1;
	}
}

//pass this back to the calling script
return terrain;
