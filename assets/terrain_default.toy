//utils
fn checkCoreBounds(arrayX, arrayY, length, posX, posY) {
	for (var i = 0; i < length; i++) {
		if (posX >= arrayX[i] - 1 &&
			posX <= arrayX[i] + 1 &&
			posY >= arrayY[i] - 1 &&
			posY <= arrayY[i] + 1
			)
			return true;
	}
	return false;
}

fn placeCoreFlags(maxAttempts) {
	for (var _ = 0; _ < maxAttempts; _++) {
		//8 random locations
		var x: Array = [rand() % terrain.width, rand() % terrain.width, rand() % terrain.width, rand() % terrain.width, rand() % terrain.width, rand() % terrain.width, rand() % terrain.width, rand() % terrain.width];
		var y: Array = [rand() % terrain.height, rand() % terrain.height, rand() % terrain.height, rand() % terrain.height, rand() % terrain.height, rand() % terrain.height, rand() % terrain.height, rand() % terrain.height];

		//check if terrain is free for each location
		if (terrain.getTile(x[0], y[0]) != 0) continue;
		if (terrain.getTile(x[1], y[1]) != 0) continue;
		if (terrain.getTile(x[2], y[2]) != 0) continue;
		if (terrain.getTile(x[3], y[3]) != 0) continue;
		if (terrain.getTile(x[4], y[4]) != 0) continue;
		if (terrain.getTile(x[5], y[5]) != 0) continue;
		if (terrain.getTile(x[6], y[6]) != 0) continue;
		if (terrain.getTile(x[7], y[7]) != 0) continue;

		//check if cores are too close
		var collision = false;
		for (var col = 2; col < 8; col++) {
			collision = collision || checkCoreBounds(x, y, col-1, x[col], y[col]);
		}
		if (collision) continue;

		//etch these flags and return
		for (var i = 0; i < 8; i++) {
			terrain.setFlag(i, x[i], y[i]);
		}
		return true;
	}
	//failed
	return null;
}



//if no preexisting terrain is available, make some
var terrain = LoadTerrain();

if (terrain == null) {
	terrain = CreateTerrain(40, 40);

	//set up some "walls" along the edges
	for (var i = 0; i < terrain.width; i++) {
		terrain.setTile(i, 0, 1);
		terrain.setTile(i, terrain.height - 1, 1);
	}

	for (var j = 0; j < terrain.height; j++) {
		terrain.setTile(0, j, 1);
		terrain.setTile(terrain.width - 1, j, 1);
	}

	//add some random obstacles
	for (var _ = 0; _ < 15; _++) {
		var x = rand() % 30 + 5;
		var y = rand() % 30 + 5;

		for (var i = 0; i < 3; i++) {
			for (var j = 0; j < 3; j++) {
				terrain.setTile(x + i, y + j, 1);
			}
		}
	}

	//try and place 8 flags for player cores
	assert placeCoreFlags(100), "Failed to place core flags in terrain";
}

//pass this back to the calling script
return terrain;