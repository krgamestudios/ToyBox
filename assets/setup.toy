InitScreen(800, 600, "Bottle Battle");
//InitLoop(null, null, null);

//check the terrain object works
var terrain = CreateTerrain(40, 40);

//set up some "walls"
for (var i = 0; i < terrain.width; i++) {
    terrain.setTile(i, 0, 1);
}

for (var j = 0; j < terrain.height; j++) {
    terrain.setTile(terrain.width - 1, j, 1);
}