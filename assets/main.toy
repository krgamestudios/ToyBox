//settings
var tileWidth: Int const = 16;
var tileHeight: Int const = 16;

//mapped
var tileGrass: Int const = 1;
var tileDirt: Int const = 25;

//useable vars
var tileset: Opaque = null;
var tilemap: Opaque = null;

fn makeTileMap(mapWidth: Int, mapHeight: Int) {
	//default grass
	var initial: Array = [].fillWith(mapWidth*mapHeight, tileGrass);

	//add sime variety
	for (var i = 0; i < mapWidth*mapHeight; i++) {
		if (rand() % 5 == 0) initial[i] += 1;
		//else if (rand() % 5 == 0) initial[i] = tileDirt;
	}

	return CreateTileMap(mapWidth, mapHeight, initial);
}

fn onReady() {
	Camera.setScaleX(2);
	Camera.setScaleY(2);

    tileset = LoadTileSet("assets/atlas.png", tileWidth, tileHeight);
    tilemap = makeTileMap(20, 20);
}

fn onFrame() {
    tilemap.drawToScreen(0, 0, tileset);
}

fn onClose() {
    //
}

//entry point
InitScreen(1280, 720, "Tiny Procgen");
InitLoop(onReady, onFrame, onClose);